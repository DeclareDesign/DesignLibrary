# Optional server overrides for the DesignLibrary Shiny app.
# copy_library_shiny() never overwrites an existing local.R.
#
# Examples:
# options(designlibrary.max_sims = 500)     # cap on simulations per run (default 1000)
# options(designlibrary.max_designs = 20)   # cap on designs in one redesign sweep (default 50)
